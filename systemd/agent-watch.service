[Unit]
Description=Agent While True budget watch and babysitter (observe only)
Documentation=https://github.com/marcelpetrick/AgentWhileTrue
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# The shipped service is deliberately read-only. Opting into terminal input
# requires an explicit user override from --observe to --auto.
ExecStart=%h/.local/bin/agent-while-true run --observe --all --no-fzf
Restart=on-failure
RestartSec=5s
# The CLI returns 130 after handling SIGINT/SIGTERM and releasing its lock.
# Treat that deliberate, clean shutdown as successful during stop/restart.
SuccessExitStatus=130
Environment=PYTHONUNBUFFERED=1
# qdbus6 requires a UTF-8 process locale and otherwise emits a warning for
# every D-Bus call, which can flood the user journal during frequent scans.
Environment=LC_ALL=C.UTF-8

[Install]
WantedBy=default.target
